{
    "required": true,
    "package": "xyz.nikitacartes.optimizedcushions.mixin",
    "plugin": "xyz.nikitacartes.optimizedcushions.mixin.OptimizedCushionsMixinPlugin",
    //? if fabric && <26.1 {
    "refmap": "client-optimizedcushions.refmap.json",
    //?}
    //? if >=26.1 {
    "compatibilityLevel": "JAVA_25",
    //?} elif >=1.21 {
    /*"compatibilityLevel": "JAVA_21",
    *///?} else {
    /*"compatibilityLevel": "JAVA_17",
    *///?}
    "client": [
        "CushionMixin",
        "EntityMixin",
        //? if <1.21.11 {
        /*"ModelPartCubeAccessor",
        *///?}
        //? if >=1.21.5 {
        "CushionRenderStateMixin",
        "CushionRendererMixin",
        //?}
        //? if >=1.21 <1.21.5 {
        /*"CushionRendererOldMixin",
        *///?}
        //? if <1.21 {
        /*"CushionRendererLegacyMixin",
        *///?}
        //? if >=26.2 {
        "LevelExtractorMixin",
        //?}
        //? if >=1.20.2 {
        "SectionCompilerMixin",
        "RenderSectionMixin",
        "LevelRendererMixin"
        //? if >=1.21.1 {
        ,
        "SodiumChunkMeshMixin"
        //? if <26.1 {
        /*,
        "LevelSliceOriginAccessor"
        *///?}
        //?}
        //?} else
        /*"ChunkRenderDispatcherMixin",
        "ChunkRenderCommitMixin",
        "LevelRendererMixin"*/
    ],
    "injectors": {
        "defaultRequire": 1
    }
}
