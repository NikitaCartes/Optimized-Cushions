{
    "required": true,
    "package": "xyz.nikitacartes.optimizedcushions.mixin",
    //? if fabric && <26.1 {
    // Obfuscated Fabric runs intermediary; the legacy Mixin AP emits this refmap, named in
    // build.fabric-obf.gradle.kts. Loom does not add the key to hand-listed configs.
    "refmap": "client-optimizedcushions.refmap.json",
    //?}
    //? if >=26.1 {
    "compatibilityLevel": "JAVA_25",
    //?} elif >=1.21 {
    /*"compatibilityLevel": "JAVA_21",
    *///?} else {
    /*"compatibilityLevel": "JAVA_17",
    *///?}
    "client": [
        "CushionMixin",
        "EntityMixin",
        //? if <1.21.11 {
        /*"ModelPartCubeAccessor",
        *///?}
        //? if >=1.21.5 {
        "CushionRenderStateMixin",
        "CushionRendererMixin",
        //?} else {
        /*"CushionRendererOldMixin",
        *///?}
        //? if >=26.2 {
        "LevelExtractorMixin",
        //?}
        //? if >=1.20.2 {
        "SectionCompilerMixin"
        //? if >=1.21.1 {
        ,
        "SodiumChunkMeshMixin"
        //? if <26.1 {
        /*,
        "LevelSliceOriginAccessor"
        *///?}
        //?}
        //?} else
        /*"ChunkRenderDispatcherMixin"*/
    ],
    "injectors": {
        "defaultRequire": 1
    }
}
