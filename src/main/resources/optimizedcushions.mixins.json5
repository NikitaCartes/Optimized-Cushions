{
    "required": true,
    "package": "xyz.nikitacartes.optimizedcushions.mixin.server",
    //? if fabric && <26.1 {
    // See the client config: obfuscated Fabric needs the AP-generated refmap; NeoForge/26.x do not.
    "refmap": "optimizedcushions.refmap.json",
    //?}
    //? if >=26.1 {
    "compatibilityLevel": "JAVA_25",
    //?} elif >=1.21 {
    /*"compatibilityLevel": "JAVA_21",
    *///?} else {
    /*"compatibilityLevel": "JAVA_17",
    *///?}
    "mixins": [
        "BlockAttachedEntityAccessor",
        "ChunkMapMixin",
        "CushionMixin",
        "EntityCallbacksMixin",
        "EntityMixin",
        "ServerEntityAccessor",
        "ServerLevelAccessor",
        "ServerLevelMixin",
        "ServerPlayerMixin",
        "TrackedEntityMixin"
    ],
    "injectors": {
        "defaultRequire": 1
    }
}
